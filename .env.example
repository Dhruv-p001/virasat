# Copy to .env and fill in. Never commit .env.

# --- Web app: lives in apps/web/.env.local, written by `pnpm env:local` for local development.
# On Vercel set the same names:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_SITE_URL,
#   NEXT_PUBLIC_AUTH_PROVIDERS (e.g. "google,apple" once configured),
#   SUPABASE_SERVICE_ROLE_KEY (server only; never with a NEXT_PUBLIC_ prefix).

# --- Capture pipeline (Phase 2, ADR 0013) ---
# "mock" runs fixtures with no keys (local development, CI). "live" uses the real providers.
# Unset: live when the keys below are present, otherwise mock. Production is always live.
AI_MODE=
# Speech-to-text for the pipeline: openai (default), sarvam or google. Needs that provider key below.
STT_PROVIDER=
# Inngest runs the pipeline. 1 sends events to the local dev server (pnpm dev:inngest). On Vercel
# set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY instead.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Claude (structuring + handwriting, Phase 2) ---
ANTHROPIC_API_KEY=

# --- Gemini (development eval only, synthetic data only: ADR 0011) ---
# A free-tier key may be used by Google to improve its products and read by human reviewers.
# Never put real family transcripts through it. eval:structure withholds them from --provider=gemini.
GEMINI_API_KEY=
# "developer" (Gemini Developer API, default) or "vertex-express" (Vertex AI express mode).
GEMINI_API_MODE=developer

# --- STT evaluation (Phase 0). Set only the providers you want to test. ---
# Sarvam: set workspace data retention to 0 days and opt out of training BEFORE sending elder audio.
SARVAM_API_KEY=
# OpenAI: API audio is not used for training by default.
OPENAI_API_KEY=
# Google Chirp 3: token from `gcloud auth print-access-token` (expires in ~1 hour).
# Bucket must be private; the harness deletes each object after use. Keep Speech data logging OFF.
GOOGLE_ACCESS_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_STT_BUCKET=
# "us" or "eu"
GOOGLE_STT_LOCATION=us
