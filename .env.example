# Copy to .env and fill in. Never commit .env.

# --- Supabase (local values come from `pnpm db:start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to a client bundle (no NEXT_PUBLIC_ prefix, ever).
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (structuring + handwriting, Phase 2) ---
ANTHROPIC_API_KEY=

# --- STT evaluation (Phase 0). Set only the providers you want to test. ---
# Sarvam: set workspace data retention to 0 days and opt out of training BEFORE sending elder audio.
SARVAM_API_KEY=
# OpenAI: API audio is not used for training by default.
OPENAI_API_KEY=
# Google Chirp 3: token from `gcloud auth print-access-token` (expires in ~1 hour).
# Bucket must be private; the harness deletes each object after use. Keep Speech data logging OFF.
GOOGLE_ACCESS_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_STT_BUCKET=
# "us" or "eu"
GOOGLE_STT_LOCATION=us
